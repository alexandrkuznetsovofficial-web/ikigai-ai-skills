#!/usr/bin/env bash
# brain-admin — kit 2.1 (brain-link). Обслуживание сервера после lockdown, без root-входа.
# Ставится в /usr/local/sbin/brain-admin (root:root 0755), вызывается: sudo brain-admin <команда>.
# Белый список команд; аргументы проверяются строго. sudoers: brain ALL=(root) NOPASSWD: /usr/local/sbin/brain-admin
set -euo pipefail
# cwd — всегда корень: иначе интерпретатор от root подхватил бы модули из папки brain
# (python3 кладёт cwd в sys.path, подмена json.py/ast.py = путь brain→root).
cd /
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8

BRAIN_HOME=/home/brain
CRED_DIR=/etc/brain-bot/credentials
LIB_DIR=/usr/local/lib/brain-bot
CONF_DIR=/etc/brain-bot   # настройки claude меняет только root
SRC_DIR=$BRAIN_HOME/.local/share/brain-link/server
BAK_DIR=/var/backups/brain-link
UNITS="brain-bot.service brain-brief.timer brain-watch.timer"
# kit 2.1 (RT-11): бот — отдельный системный пользователь brainbot (группа brain, без входа). Его состояние
# (конфиг claude, безопасный режим, итоги самопроверки) — /var/lib/brain-bot (0700 brainbot): brain туда не видит.
BOT_USER=brainbot
BOT_STATE=/var/lib/brain-bot
LEGACY_STATE=$BRAIN_HOME/.local/state/brain-bot
# что переносим из состояния ранних установок (бот под brain): только эти обычные файлы
LEGACY_FILES="safe_mode selfcheck.json selfcheck_runs.json watch_state.json calls.json"

die() { echo "❌ $*" >&2; exit 1; }
ok() { echo "✅ $*"; }
warn() { echo "🟡 $*"; }

[ "$(id -u)" -eq 0 ] || die "запускать через sudo: sudo brain-admin $*"

usage() {
  cat <<'USAGE'
sudo brain-admin <команда>
  restart-bot              перезапустить бота
  bot-user                 пользователь бота brainbot, права памяти, /var/lib/brain-bot, перенос с ранних установок
  bot-state                итог самопроверки и безопасный режим (для brain-link report)
  status                   состояние бота, таймеров, диска, часов
  logs [N]                 последние N строк журнала бота (по умолчанию 100, максимум 2000)
  set-token bot|claude     принять токен со стандартного ввода (ввод скрыт), записать 0600 root, рестарт
  timesync-restart         перезапустить синхронизацию часов
  update-bot               обновить код бота и настройки claude из ~/.local/share/brain-link/server
  selftest                 проверка бота без сети
  selfcheck-security       самопроверка безопасности на живом claude (приманки, секреты, SSRF) в песочнице
                           юнита brain-bot (systemd-run с его свойствами); ≤ 8 вызовов, не чаще раза в сутки
  canary-init              положить приманки самопроверки (фальшивые CANARY-значения), идемпотентно
  clear-canary-hit         снять безопасный режим «приманка в живом ответе» — ТОЛЬКО после разбора с куратором
  update-claude            обновить Claude Code официальным установщиком под brain, проверить флаги, рестарт бота
  remove-private           удалить на сервере personal/ и прочие исключённые пути из memory (подтверждение YES)
USAGE
}

owner_id() {
  systemctl show -p Environment --value brain-bot.service 2>/dev/null | tr ' ' '\n' | sed -n 's/^OWNER_ID=//p' | head -1
}

# Копирует один файл из папки brain в root-владение. Читаем С ПРАВАМИ brain (runuser),
# поэтому подложенный симлинк на /etc/shadow и т.п. root-чтения не даст.
safe_install() { # src dst mode owner:group
  local src=$1 dst=$2 mode=$3 og=$4
  [ -f "$src" ] && [ ! -L "$src" ] || die "нет обычного файла: $src"
  local tmp; tmp=$(mktemp "$(dirname "$dst")/.tmp.XXXXXX")
  runuser -u brain -- head -c 1048577 -- "$src" > "$tmp" || { rm -f "$tmp"; die "не читается: $src"; }
  [ "$(stat -c %s "$tmp")" -le 1048576 ] || { rm -f "$tmp"; die "слишком большой файл: $src"; }
  chown "$og" "$tmp"; chmod "$mode" "$tmp"
  echo "$tmp"
}

# >>> claude-flags — одна логика: здесь, в CAPS_SH установщика (brain_link.py) и в claude_capabilities() бота.
# Флаг принят, если `claude <флаг> [значение] --version` завершается с кодом 0 (оба написания
# --allowedTools/--allowed-tools). --help — только для отчёта и как запасной путь, если claude «принимает»
# даже несуществующий флаг. claude запускается С ПРАВАМИ brainbot и с конфигом бота (до шага bot — от brain),
# root его не запускает.
cl_run() {
  CE="env -i HOME=/home/brain PATH=/home/brain/.local/bin:/usr/bin:/bin LANG=C.UTF-8 DISABLE_AUTOUPDATER=1"
  if [ "$(id -u)" = 0 ] && id brainbot >/dev/null 2>&1 && [ -d /var/lib/brain-bot ]; then
    timeout 30 runuser -u brainbot -- $CE CLAUDE_CONFIG_DIR=/var/lib/brain-bot/claude-config /home/brain/.local/bin/claude "$@"
  elif [ "$(id -u)" = 0 ]; then   # до шага bot (brainbot ещё нет): от brain, конфиг-черновик в его кэше
    timeout 30 runuser -u brain -- $CE CLAUDE_CONFIG_DIR=/home/brain/.cache/brain-link-claude-probe /home/brain/.local/bin/claude "$@"
  else timeout 30 $CE CLAUDE_CONFIG_DIR="${HOME:-/tmp}/.cache/brain-link-claude-probe" /home/brain/.local/bin/claude "$@"; fi
}
cl_flag() { cl_run "$@" --version </dev/null >/dev/null 2>&1; }
cl_has() { # «--флаг[,--написание2]» значение|-   (- — флаг без значения)
  local n
  for n in $(printf '%s' "$1" | tr ',' ' '); do
    if [ "$CL_M" = exec ]; then
      if [ "$2" = - ]; then cl_flag "$n" && return 0; else cl_flag "$n" "$2" && return 0; fi
    elif printf '%s\n' "$CL_H" | grep -qE -- "(^|[^-[:alnum:]])$n([^-[:alnum:]]|$)"; then return 0; fi
  done
  return 1
}
cl_caps() { # печатает CAP_METHOD=exec|help|none и CAP_<ФЛАГ>=1|0
  CL_H=""; CL_M=none
  if [ -x /home/brain/.local/bin/claude ]; then
    CL_H=$(cl_run --help </dev/null 2>/dev/null || true)
    if cl_flag --brain-link-no-such-flag; then
      [ -n "$CL_H" ] && CL_M=help        # «принимает» любой флаг — исполнение ничего не различает
    elif cl_flag; then CL_M=exec
    elif [ -n "$CL_H" ]; then CL_M=help; fi
  fi
  echo "CAP_METHOD=$CL_M"
  [ "$CL_M" = none ] && return 0
  if cl_has --tools ""; then echo CAP_TOOLS=1; else echo CAP_TOOLS=0; fi
  if cl_has --setting-sources ""; then echo CAP_SETTING_SOURCES=1; else echo CAP_SETTING_SOURCES=0; fi
  if cl_has --allowedTools,--allowed-tools Read; then echo CAP_ALLOWEDTOOLS=1; else echo CAP_ALLOWEDTOOLS=0; fi
  if cl_has --disallowedTools,--disallowed-tools Bash; then echo CAP_DISALLOWEDTOOLS=1; else echo CAP_DISALLOWEDTOOLS=0; fi
  if cl_has --no-session-persistence -; then echo CAP_NO_SESSION_PERSISTENCE=1; else echo CAP_NO_SESSION_PERSISTENCE=0; fi
  if cl_has --strict-mcp-config -; then echo CAP_STRICT_MCP_CONFIG=1; else echo CAP_STRICT_MCP_CONFIG=0; fi
}
# <<< claude-flags

cmd=${1:-}
case "$cmd" in
  restart-bot)
    systemctl restart brain-bot.service
    sleep 3
    systemctl is-active --quiet brain-bot.service && ok "бот перезапущен" || die "бот не поднялся: sudo brain-admin logs 50"
    ;;

  bot-user)
    # kit 2.1 (RT-11). Идемпотентно; вызывают harden.sh и шаг bot (до lockdown), можно и вручную.
    # 1) системный пользователь brainbot: без входа и пароля, в группе brain, без sudo;
    # 2) /var/lib/brain-bot 0700 brainbot (StateDirectory юнитов) + claude-config и cache внутри;
    # 3) права памяти: файлы 0640, папки 0750, inbox/dialogues 2770 — всё ОТ brain (его файлы, симлинки не страшны);
    # 4) перенос состояния ранней установки (бот под brain): brain читает свои файлы, brainbot пишет в свою папку.
    id brain >/dev/null 2>&1 || die "нет пользователя brain — сначала harden"
    if id "$BOT_USER" >/dev/null 2>&1; then ok "пользователь $BOT_USER уже есть"
    else
      useradd --system --user-group --no-create-home --home-dir "$BOT_STATE" --shell /usr/sbin/nologin "$BOT_USER" \
        || die "useradd $BOT_USER не прошёл"
      ok "системный пользователь $BOT_USER создан (nologin, без домашней папки в /home)"
    fi
    usermod -aG brain "$BOT_USER" || die "не добавил $BOT_USER в группу brain"
    usermod -s /usr/sbin/nologin "$BOT_USER" >/dev/null 2>&1 || true
    passwd -l "$BOT_USER" >/dev/null 2>&1 || true
    for g in sudo admin wheel; do gpasswd -d "$BOT_USER" "$g" >/dev/null 2>&1 || true; done
    # brain НЕ должен состоять в группе brainbot (иначе видел бы его файлы)
    gpasswd -d brain "$BOT_USER" >/dev/null 2>&1 || true
    ok "$BOT_USER: группы $(id -nG "$BOT_USER" | tr ' ' ',')"
    [ -L "$BOT_STATE" ] && die "$BOT_STATE — симлинк, не трогаю"
    install -d -m 0700 -o "$BOT_USER" -g brain "$BOT_STATE"
    chown "$BOT_USER:brain" "$BOT_STATE"; chmod 0700 "$BOT_STATE"
    for d in claude-config cache; do
      runuser -u "$BOT_USER" -- sh -c 'umask 077; [ -L "$1" ] && exit 3; mkdir -p "$1" && chmod 0700 "$1"' sh "$BOT_STATE/$d" \
        || die "не создал $BOT_STATE/$d"
    done
    ok "состояние бота: $BOT_STATE (0700 $BOT_USER), конфиг claude: $BOT_STATE/claude-config"
    # права памяти — от brain: его папка, его файлы. brainbot читает (группа brain), пишет только inbox/dialogues.
    runuser -u brain -- sh -c '
      cd /home/brain || exit 1
      chmod 0750 /home/brain
      for d in memory .claude .claude/skills .local .local/bin .local/share .local/state .config .brain-sync; do
        [ -d "$d" ] && [ ! -L "$d" ] && chmod 0750 "$d"
      done
      [ -L memory ] && exit 3
      mkdir -p memory/inbox memory/dialogues && chmod 0750 memory
      for d in memory/inbox memory/dialogues; do [ -L "$d" ] && exit 3; chmod 2770 "$d" || exit 4; done
      # ACL (наследованные от /home и т.п.): chmod меняет только маску, запись группе даёт запись group::
      if command -v setfacl >/dev/null 2>&1; then
        for d in memory/inbox memory/dialogues; do
          setfacl -m g::rwx,m::rwx "$d" 2>/dev/null
          getfacl -d -c "$d" 2>/dev/null | grep -q . && setfacl -d -m g::rwx,m::rwx "$d" 2>/dev/null
        done
      fi
      if [ -f CLAUDE.md ] && [ ! -L CLAUDE.md ]; then chmod u+rw,g+r,g-w,o-rwx CLAUDE.md; fi
      find -P memory .claude/skills -xdev \( -path memory/inbox -o -path memory/dialogues \) -prune -o -user brain \
        \( -type d -exec chmod u+rwx,g+rx,g-w,o-rwx {} + -o -type f -exec chmod u+rw,g+r,g-w,o-rwx {} + \) 2>/dev/null
      find -P memory/inbox memory/dialogues -xdev -mindepth 1 -user brain \
        \( -type d -exec chmod 2770 {} + -o -type f -exec chmod u+rw,g+rw,o-rwx {} + \) 2>/dev/null
      exit 0' && ok "права памяти: файлы 0640, папки 0750, inbox и dialogues 2770 (группа brain)" \
      || die "права памяти не выставились (memory, inbox или dialogues — симлинк?)"
    # перенос состояния ранней установки (бот был под brain): только обычные файлы из белого списка
    if [ -d "$LEGACY_STATE" ] && [ ! -L "$LEGACY_STATE" ] && [ ! -e "$BOT_STATE/.migrated-from-brain" ]; then
      n=0
      for f in $LEGACY_FILES; do
        runuser -u brain -- test -f "$LEGACY_STATE/$f" -a ! -L "$LEGACY_STATE/$f" 2>/dev/null || continue
        if runuser -u brain -- head -c 1048576 -- "$LEGACY_STATE/$f" \
           | runuser -u "$BOT_USER" -- sh -c 'umask 077; [ -L "$1" ] && exit 3; t="$1.tmp.$$"; cat > "$t" && mv -f "$t" "$1"' sh "$BOT_STATE/$f"; then
          n=$((n+1))
        else warn "не перенёс $f из $LEGACY_STATE"; fi
      done
      runuser -u "$BOT_USER" -- sh -c 'date +%s > "$1"' sh "$BOT_STATE/.migrated-from-brain"
      # старое состояние (в т.ч. прежний конфиг claude бота) убираем — от brain, это его папка
      runuser -u brain -- rm -rf --one-file-system -- "$LEGACY_STATE" 2>/dev/null || warn "не удалил $LEGACY_STATE"
      ok "перенесено состояние ранней установки: $n файл(ов) из $LEGACY_STATE (безопасный режим сохранён)"
    fi
    ;;

  status)
    for u in $UNITS; do printf '%-22s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || true)"; done
    # строка «ufw: active|inactive|none» — её читает audit (sudo -n brain-admin status), формат не менять
    if command -v ufw >/dev/null 2>&1; then
      if ufw status 2>/dev/null | grep -qi '^Status: active'; then echo "ufw: active"; else echo "ufw: inactive"; fi
    else echo "ufw: none"; fi
    echo "--- диск"; df -h "$BRAIN_HOME" | tail -1
    echo "--- часы"; timedatectl show -p NTPSynchronized -p Timezone 2>/dev/null || true
    echo "--- синк"; if [ -f "$BRAIN_HOME/.brain-sync/heartbeat" ]; then stat -c 'heartbeat: %y' "$BRAIN_HOME/.brain-sync/heartbeat"; else echo "heartbeat: нет"; fi
    echo "--- секреты"; ls -l "$CRED_DIR" 2>/dev/null | sed 1d | awk '{print $1, $3, $NF}' || true
    echo "--- таймеры"; systemctl list-timers 'brain-*' --no-pager 2>/dev/null | head -5 || true
    echo "--- fail2ban"; fail2ban-client status sshd 2>/dev/null | grep -E 'Currently banned|Total banned' | sed 's/^[^A-Za-z]*//' || echo "fail2ban: нет"
    # файлы из папки brain root читает С ПРАВАМИ brain: подложенный симлинк на /etc/shadow ничего не даст
    echo "bot-user: $(systemctl show -p User --value brain-bot.service 2>/dev/null)"
    st=$BOT_STATE
    if runuser -u "$BOT_USER" -- test -e "$st/safe_mode" 2>/dev/null; then echo "safe_mode: on"; runuser -u "$BOT_USER" -- head -c 2000 "$st/safe_mode"; echo
    else echo "safe_mode: off"; fi
    runuser -u "$BOT_USER" -- sed -n 's/^ "status": "\([a-z]*\)".*/selfcheck: \1/p' "$st/selfcheck.json" 2>/dev/null | head -1 || true
    ;;

  bot-state)
    # для brain-link report: состояние бота читает brainbot (root файлы из папки бота не открывает)
    echo "=== selfcheck.json"; runuser -u "$BOT_USER" -- head -c 20000 "$BOT_STATE/selfcheck.json" 2>/dev/null || echo "нет (самопроверка ещё не запускалась)"
    echo; echo "=== safe_mode"; runuser -u "$BOT_USER" -- head -c 4000 "$BOT_STATE/safe_mode" 2>/dev/null || echo "нет — обычный режим"
    ;;

  logs)
    n=${2:-100}
    [[ "$n" =~ ^[0-9]{1,4}$ ]] && [ "$n" -ge 1 ] && [ "$n" -le 2000 ] || die "N — число от 1 до 2000"
    journalctl -u brain-bot.service -u brain-brief.service -u brain-watch.service -n "$n" --no-pager
    ;;

  set-token)
    name=${2:-}
    case "$name" in
      bot) re='^[0-9]{6,12}:[A-Za-z0-9_-]{30,}$' ;;
      claude) re='^sk-ant-oat[0-9A-Za-z_-]{20,}$' ;;   # только токен подписки (claude setup-token), не API-ключ
      *) die "set-token bot|claude" ;;
    esac
    if [ -t 0 ]; then
      read -r -s -p "Вставь токен ($name) и нажми Enter: " value; echo
    else
      IFS= read -r value || true
    fi
    value=${value//$'\r'/}
    [ "${#value}" -le 400 ] || die "слишком длинная строка"
    [[ "$value" =~ $re ]] || die "это не похоже на токен ($name). Ничего не записано."
    install -d -m 0700 -o root -g root "$CRED_DIR"
    tmp=$(mktemp "$CRED_DIR/.tmp.XXXXXX")
    printf '%s' "$value" > "$tmp"
    unset value
    chmod 0600 "$tmp"; chown root:root "$tmp"
    mv -f "$tmp" "$CRED_DIR/${name}_token"
    ok "токен $name записан в $CRED_DIR/${name}_token (0600 root)"
    if systemctl is-enabled --quiet brain-bot.service 2>/dev/null; then
      systemctl restart brain-bot.service && ok "бот перезапущен"
    fi
    ;;

  timesync-restart)
    timedatectl set-ntp true
    systemctl restart systemd-timesyncd.service 2>/dev/null || warn "systemd-timesyncd не найден (возможно, chrony)"
    sleep 5
    timedatectl show -p NTPSynchronized
    ;;

  update-bot)
    # Только код бота и настройки claude: юниты и сам brain-admin отсюда НЕ обновляются —
    # папка принадлежит brain, иначе это был бы путь к root.
    [ -d "$SRC_DIR" ] && [ ! -L "$SRC_DIR" ] || die "нет папки $SRC_DIR"
    install -d -m 0755 -o root -g root "$LIB_DIR" "$CONF_DIR"
    t1=$(safe_install "$SRC_DIR/brain_bot.py" "$LIB_DIR/brain_bot.py" 0755 root:root)
    # Проверки содержимого — от brain и в изолированном режиме (-I: без cwd, PYTHON*, user site).
    # Root-интерпретатор файлов из папки brain не трогает вообще.
    runuser -u brain -- /usr/bin/python3 -I - "$t1" <<'PY' || { rm -f "$t1"; die "brain_bot.py не компилируется"; }
import ast, sys
ast.parse(open(sys.argv[1], encoding="utf-8").read(), feature_version=(3, 9))
PY
    t2=$(safe_install "$SRC_DIR/claude_settings.json" "$CONF_DIR/claude_settings.json" 0644 root:root)
    runuser -u brain -- /usr/bin/python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); p=d["permissions"]; assert p["deny"] and p["allow"] and d.get("disableAllHooks") is True' "$t2" \
      || { rm -f "$t1" "$t2"; die "claude_settings.json битый или без deny/allow/disableAllHooks"; }
    install -d -m 0700 -o root -g root "$BAK_DIR"
    for f in "$LIB_DIR/brain_bot.py" "$CONF_DIR/claude_settings.json"; do
      [ -f "$f" ] && cp -p "$f" "$BAK_DIR/$(basename "$f").$(date +%Y%m%d_%H%M%S)"
    done
    mv -f "$t1" "$LIB_DIR/brain_bot.py"
    mv -f "$t2" "$CONF_DIR/claude_settings.json"
    ok "код бота и настройки обновлены"
    "$0" selftest || warn "selftest с замечаниями"
    systemctl restart brain-bot.service && ok "бот перезапущен"
    ;;

  selftest)
    rc=0
    for n in bot_token claude_token; do
      f="$CRED_DIR/$n"
      if [ -f "$f" ] && [ "$(stat -c '%a %U' "$f")" = "600 root" ]; then ok "секрет $n: 0600 root"; else echo "❌ секрет $n: нет или права не 0600 root"; rc=1; fi
    done
    [ "$(stat -c '%a %U' "$CRED_DIR" 2>/dev/null)" = "700 root" ] && ok "$CRED_DIR: 0700 root" || { echo "❌ $CRED_DIR не 0700 root"; rc=1; }
    cc=$BOT_STATE/claude-config
    [ -d "$cc" ] && [ ! -L "$cc" ] && [ "$(stat -c '%a %U' "$cc")" = "700 $BOT_USER" ] && [ "$(stat -c '%a %U' "$BOT_STATE")" = "700 $BOT_USER" ] \
      && ok "состояние и конфиг claude бота: $BOT_STATE (0700 $BOT_USER)" \
      || { echo "❌ нет $cc / $BOT_STATE 0700 $BOT_USER (CLAUDE_CONFIG_DIR бота) — sudo brain-admin bot-user"; rc=1; }
    # RT-11: секреты и состояние бота не читаются от brain — ни исходные, ни выданные юниту
    leak=""
    for f in "$CRED_DIR/bot_token" "$CRED_DIR/claude_token" /run/credentials/brain-bot.service/bot_token \
             /run/credentials/brain-bot.service/claude_token "$BOT_STATE/selfcheck.json" "$BOT_STATE/canary-bait"; do
      runuser -u brain -- cat -- "$f" >/dev/null 2>&1 && leak="$leak $f"
    done
    runuser -u brain -- ls -- "$BOT_STATE" >/dev/null 2>&1 && leak="$leak $BOT_STATE/"
    [ -z "$leak" ] && ok "brain не читает секреты бота (/etc и /run/credentials) и его состояние" \
      || { echo "❌ brain читает:$leak — бот должен работать под $BOT_USER (brain-link bot до lockdown)"; rc=1; }
    for f in "$BRAIN_HOME"/.claude/settings.json "$BRAIN_HOME"/.claude/settings.local.json; do
      [ -e "$f" ] && warn "$f есть — бот его НЕ читает (--setting-sources пустой), но лучше убрать"
    done
    oid=$(owner_id || true)
    [[ "$oid" =~ ^[0-9]+$ ]] && ok "OWNER_ID задан в юните" || { echo "❌ OWNER_ID в юните не задан (fail-closed)"; rc=1; }
    bu=$(systemctl show -p User --value brain-bot.service 2>/dev/null || true)
    if [ "$bu" = "$BOT_USER" ]; then ok "бот запускается под $BOT_USER (не brain)"
    else echo "❌ бот под «${bu:-?}», а не $BOT_USER — повтори шаг bot до lockdown (переведёт)"; rc=1; fi
    id -nG "$BOT_USER" 2>/dev/null | tr ' ' '\n' | grep -qx brain && ok "$BOT_USER в группе brain (читает память)" \
      || { echo "❌ $BOT_USER не в группе brain — sudo brain-admin bot-user"; rc=1; }
    [ "$(stat -c '%a %G' "$BRAIN_HOME/memory/inbox" 2>/dev/null)" = "2770 brain" ] && ok "memory/inbox 2770 brain" \
      || { echo "❌ memory/inbox не 2770 brain — sudo brain-admin bot-user"; rc=1; }
    if grep -rqs 'ANTHROPIC_API_KEY' /etc/environment /etc/systemd/system/brain-*.service "$BRAIN_HOME/.profile" "$BRAIN_HOME/.bashrc"; then
      echo "❌ где-то задан ANTHROPIC_API_KEY — убрать"; rc=1
    else ok "ANTHROPIC_API_KEY нигде не задан"; fi
    if [ -f "$CONF_DIR/canary.list" ] && [ "$(stat -c '%a %U' "$CONF_DIR/canary.list")" = "600 root" ]; then ok "приманки самопроверки: $CONF_DIR/canary.list (0600 root)"
    else echo "❌ нет приманок самопроверки ($CONF_DIR/canary.list 0600 root) — sudo brain-admin canary-init"; rc=1; fi
    runuser -u brainbot -- env -i HOME="$BRAIN_HOME" LANG=C.UTF-8 OWNER_ID="${oid:-0}" BRAIN_STATE_DIR="$BOT_STATE" \
      PATH="$BRAIN_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin" \
      /usr/bin/python3 -I "$LIB_DIR/brain_bot.py" selftest || rc=1
    exit $rc
    ;;

  canary-init)
    # Приманки — ФАЛЬШИВЫЕ уникальные значения CANARY-<случайно>, генерируются при установке.
    # Настоящие токены здесь не используются никогда. Значения помнит только root: $CONF_DIR/canary.list (0600).
    install -d -m 0755 -o root -g root "$CONF_DIR"
    LIST=$CONF_DIR/canary.list
    gen() { printf 'CANARY-%s' "$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"; }
    # 4 значения: /etc (root), ~/.config и ~/.claude (brain), состояние бота (brainbot — её бот ЧИТАЕТ, держит слой claude).
    # Прежние значения сохраняем, недостающие (установки с тремя приманками) — дописываем.
    V=()
    if [ -f "$LIST" ] && [ ! -L "$LIST" ]; then mapfile -t V < <(grep '^CANARY-[0-9a-f]\{16,\}$' "$LIST" | head -4); fi
    if [ "${#V[@]}" -ge 4 ]; then ok "приманки уже есть — значения прежние"
    else
      while [ "${#V[@]}" -lt 4 ]; do V+=("$(gen)"); done
      tmp=$(mktemp "$CONF_DIR/.tmp.XXXXXX"); printf '%s\n' "${V[@]}" > "$tmp"
      chmod 0600 "$tmp"; chown root:root "$tmp"; mv -f "$tmp" "$LIST"
      ok "приманки сгенерированы: $LIST (0600 root)"
    fi
    tmp=$(mktemp "$CONF_DIR/.tmp.XXXXXX")
    printf 'brain-link canary: FAKE secret for the security self-check, not a real token\n%s\n' "${V[0]}" > "$tmp"
    chmod 0600 "$tmp"; chown root:root "$tmp"; mv -f "$tmp" "$CONF_DIR/canary"
    ok "приманка $CONF_DIR/canary (0600 root)"
    # В домашней папке brain пишем ОТ brain: подложенный симлинк root-записи не даст.
    put_brain() { # path content
      printf '%s\n' "$2" | runuser -u brain -- sh -c 'umask 077; d=$(dirname "$1"); { [ -d "$d" ] && [ ! -L "$d" ]; } || exit 3
        t="$1.tmp.$$"; cat > "$t" && chmod 600 "$t" && mv -f "$t" "$1"' sh "$1"
    }
    put_brain "$BRAIN_HOME/.config/brain-canary" "brain-link canary: FAKE secret ${V[1]}" \
      && ok "приманка ~/.config/brain-canary (0600 brain)" || warn "не положил ~/.config/brain-canary (нет папки?)"
    put_brain "$BRAIN_HOME/.claude/.canary-credentials.json" \
      "{\"claudeAiOauth\": {\"accessToken\": \"${V[2]}\", \"note\": \"brain-link canary, fake\"}}" \
      && ok "приманка ~/.claude/.canary-credentials.json (0600 brain)" || warn "не положил ~/.claude/.canary-credentials.json"
    # Приманки в /home/brain (0600 brain) бот (brainbot) не прочтёт уже правами ОС. Эту — прочтёт: она в его
    # состоянии, вне белого списка claude. Пишет brainbot в свою папку (не root).
    if id "$BOT_USER" >/dev/null 2>&1 && [ -d "$BOT_STATE" ] && [ ! -L "$BOT_STATE" ]; then
      printf '%s\n' "brain-link canary: FAKE secret (bot state) ${V[3]}" | runuser -u "$BOT_USER" -- sh -c 'umask 077
        [ -L "$1" ] && exit 3; t="$1.tmp.$$"; cat > "$t" && chmod 600 "$t" && mv -f "$t" "$1"' sh "$BOT_STATE/canary-bait" \
        && ok "приманка $BOT_STATE/canary-bait (0600 $BOT_USER — бот её читает, отказать обязан слой claude)" \
        || warn "не положил $BOT_STATE/canary-bait"
    else warn "нет $BOT_USER или $BOT_STATE — приманку состояния бота положит sudo brain-admin bot-user, затем canary-init"; fi
    ;;

  selfcheck-security)
    # Честная проверка: тот же код бота, тот же claude, ТЕ ЖЕ свойства песочницы, что у brain-bot.service
    # (LoadCredential, ProtectHome, ProtectProc, IPAddressDeny…) — итоговые, с drop-in (systemctl cat),
    # и передаём их systemd-run. Запасной запуск без песочницы — ТОЛЬКО если systemd-run нет или он не
    # принял свойства (Unknown assignment / Failed to start transient); в выводе SELFCHECK_SANDBOX=fallback,
    # verify считает такой итог «не проверено». Задача стартовала и умерла без итога — «не проверено».
    UNIT=/etc/systemd/system/brain-bot.service
    [ -f "$UNIT" ] || die "нет $UNIT — сначала brain-link bot"
    UNIT_TXT=$(systemctl cat brain-bot.service 2>/dev/null || cat "$UNIT")
    grep -q '__OWNER_ID__' <<<"$UNIT_TXT" && die "OWNER_ID в юните не задан — сначала brain-link bot"
    dropins=$(systemctl show -p DropInPaths --value brain-bot.service 2>/dev/null || true)
    if [ -n "$dropins" ] || compgen -G "/etc/systemd/system/brain-bot.service.d/*.conf" >/dev/null; then
      warn "у brain-bot.service есть drop-in (${dropins:-brain-bot.service.d/}) — самопроверка берёт свойства с его учётом; проверь, что он не ослабляет песочницу"
    fi
    [ -f "$CONF_DIR/canary.list" ] || "$0" canary-init
    # RuntimeMaxSec > SELFCHECK_BUDGET бота (≈1700 с); brain_link.py ждёт ssh дольше (SELFCHECK_TIMEOUT)
    props=(-p User=brainbot -p Group=brain -p "WorkingDirectory=$BRAIN_HOME" -p RuntimeMaxSec=1800)
    while IFS= read -r line; do
      case "$line" in ''|'#'*|'['*) continue ;; esac
      case "${line%%=*}" in
        Type|Restart|RestartSec|ExecStart|ExecStartPre|ExecStartPost|ExecReload|ExecStop|TimeoutStartSec|\
        StartLimitIntervalSec|StartLimitBurst|WorkingDirectory|User|Group|RuntimeMaxSec) continue ;;
      esac
      props+=(-p "$line")
    done < <(sed -n '/^\[Service\]/,/^\[/p' <<<"$UNIT_TXT")
    grep -q '^LoadCredential=canary_list:' <<<"$UNIT_TXT" || props+=(-p "LoadCredential=canary_list:$CONF_DIR/canary.list")
    grep -q '^Environment=BRAIN_STATE_DIR=' <<<"$UNIT_TXT" || props+=(-p "Environment=BRAIN_STATE_DIR=$BOT_STATE")
    # журнал ошибок без секретов: шаблоны токенов вырезаются (на случай трассировки с аргументами)
    errtail() { sed -E 's/sk-ant-[A-Za-z0-9_-]+/<скрыто>/g; s/[0-9]{8,10}:[A-Za-z0-9_-]{30,}/<скрыто>/g' "$1" | grep -vE '^INFO ' | tail -8 >&2 || true; }
    out=$(mktemp); err=$(mktemp); rc=0; mode=systemd; CD=""
    trap 'rm -f "$out" "$err"' EXIT HUP INT TERM
    if command -v systemd-run >/dev/null 2>&1; then
      systemd-run --quiet --wait --pipe --collect --unit="brain-selfcheck-$$" "${props[@]}" -p User=brainbot /usr/bin/python3 -I "$LIB_DIR/brain_bot.py" selfcheck </dev/null >"$out" 2>"$err" || rc=$?
      if ! grep -q '^SELFCHECK=' "$out"; then
        if grep -qE 'Unknown assignment|Failed to start transient' "$err"; then
          warn "systemd-run не принял свойства юнита ($(grep -m1 -E 'Unknown assignment|Failed to start transient' "$err" | head -c 200)) — запускаю с тем же окружением без песочницы"
          mode=fallback
        else
          cat "$out"
          errtail "$err"
          echo "🟡 не проверено: самопроверка в песочнице запустилась, но завершилась без итога (код $rc) — sudo brain-admin logs 100"
          echo "SELFCHECK=unverified"
          echo "SELFCHECK_CACHED=0"
          echo "SELFCHECK_SANDBOX=systemd"
          exit 3
        fi
      fi
    else
      warn "systemd-run нет — запуск с тем же окружением без песочницы systemd"
      mode=fallback
    fi
    if [ "$mode" = fallback ]; then
      rc=0
      CD=$(mktemp -d /run/brain-selfcheck.XXXXXX)
      trap 'rm -rf "$CD"; rm -f "$out" "$err"' EXIT HUP INT TERM   # копии токенов не переживут обрыв
      for n in bot_token claude_token; do if [ -f "$CRED_DIR/$n" ]; then cp "$CRED_DIR/$n" "$CD/$n"; fi; done
      cp "$CONF_DIR/canary.list" "$CD/canary_list"
      chown -R "$BOT_USER:$BOT_USER" "$CD"; chmod 0700 "$CD"; chmod 0600 "$CD"/*
      oid=$(owner_id || true)
      tz=$(systemctl show -p Environment --value brain-bot.service 2>/dev/null | tr ' ' '\n' | sed -n 's/^BOT_TZ=//p' | head -1)
      runuser -u brainbot -- env -i HOME="$BRAIN_HOME" LANG=C.UTF-8 OWNER_ID="${oid:-0}" BOT_TZ="${tz:-Europe/Moscow}" \
        BRAIN_STATE_DIR="$BOT_STATE" XDG_CACHE_HOME="$BOT_STATE/cache" \
        PATH="$BRAIN_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin" CREDENTIALS_DIRECTORY="$CD" BRAIN_SELFCHECK_SANDBOX=fallback \
        /usr/bin/python3 -I "$LIB_DIR/brain_bot.py" selfcheck </dev/null >"$out" 2>"$err" || rc=$?
      rm -rf "$CD"
    fi
    cat "$out"
    if grep -q '^SELFCHECK=' "$out"; then grep -E '^(ERROR|CRITICAL)' "$err" | tail -5 >&2 || true; else errtail "$err"; fi
    exit "$rc"
    ;;

  clear-canary-hit)
    # Причина canary-hit: в ЖИВОМ ответе модели оказалась приманка. Самопроверка её не снимает — только
    # человек, после разбора с куратором (brain-link report). Файл состояния пишет brainbot (runuser), не root.
    st=$BOT_STATE
    if ! runuser -u brainbot -- grep -qs '"canary-hit"' "$st/safe_mode"; then ok "причины canary-hit нет"; exit 0; fi
    warn "снимаешь безопасный режим после срабатывания приманки. Делай это только после разбора с куратором."
    answer=""
    read -r -t 60 -p "Напиши YES в течение 60 секунд, чтобы снять canary-hit: " answer || die "время вышло или ввода нет — отменено"
    [ "$answer" = "YES" ] || die "отменено"
    oid=$(owner_id || true)
    runuser -u brainbot -- env -i HOME="$BRAIN_HOME" LANG=C.UTF-8 OWNER_ID="${oid:-0}" BRAIN_STATE_DIR="$BOT_STATE" \
      PATH="$BRAIN_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin" \
      /usr/bin/python3 -I "$LIB_DIR/brain_bot.py" clear-canary-hit
    ;;

  update-claude)
    LOG=$(mktemp)
    if runuser -l brain -c 'curl -fsSL https://claude.ai/install.sh | bash' >"$LOG" 2>&1; then
      ok "Claude Code обновлён официальным установщиком (под brain)"
    else tail -5 "$LOG" >&2; rm -f "$LOG"; die "установщик Claude Code упал (сеть? место на диске?)"; fi
    rm -f "$LOG"
    v=$(cl_run --version </dev/null 2>/dev/null | head -1 || true)
    echo "claude: ${v:-не отвечает}"
    caps=$(cl_caps)
    method=$(sed -n 's/^CAP_METHOD=//p' <<<"$caps")
    if [ "$method" = none ]; then
      systemctl restart brain-bot.service && ok "бот перезапущен"
      warn "claude не ответил ни на проверку флагов, ни на --help — флаги изоляции НЕ проверены. Бот проверит их сам при старте; итог — в /status"
      exit 0
    fi
    [ "$method" = help ] && warn "claude принимает даже несуществующий флаг — флаги проверены только по --help"
    miss=0
    for kf in TOOLS:--tools SETTING_SOURCES:--setting-sources ALLOWEDTOOLS:--allowedTools DISALLOWEDTOOLS:--disallowedTools; do
      if grep -qx "CAP_${kf%%:*}=1" <<<"$caps"; then ok "флаг ${kf#*:} есть"; else echo "❌ флага ${kf#*:} нет"; miss=1; fi
    done
    systemctl restart brain-bot.service && ok "бот перезапущен"
    [ "$miss" = 0 ] || die "не все флаги изоляции есть — бот остаётся в безопасном режиме, напиши куратору"
    ok "флаги изоляции на месте — безопасный режим по причине claude-flags бот снимет сам при старте"
    ;;

  remove-private)
    # Всё внутри memory принадлежит brain, поэтому find и rm идут С ПРАВАМИ brain (runuser):
    # подменённый между find и rm путь (симлинк на /etc и т.п.) root-удаления не даст.
    # find -P не ходит по симлинкам; rm -rf удаляет сам симлинк, а не цель.
    mem=$BRAIN_HOME/memory
    [ -d "$mem" ] && [ ! -L "$mem" ] || die "нет $mem (или это симлинк)"
    mapfile -d '' found < <(runuser -u brain -- find -P "$mem" -xdev \( -type d \( -name personal -o -name private -o -name 'secret*' -o -name sessions -o -name .secrets -o -name .git -o -name .config \) -prune -print0 \) -o \( \( -type f -o -type l \) \( -name .env -o -name '*.env' -o -name '*.session' \) -print0 \))
    if [ "${#found[@]}" -eq 0 ]; then ok "исключённых путей на сервере нет"; exit 0; fi
    echo "Будут удалены на сервере (на компьютере всё остаётся):"
    printf '  %q\n' "${found[@]}"
    answer=""
    read -r -t 60 -p "Напиши YES в течение 60 секунд, чтобы удалить: " answer || die "время вышло или ввода нет — отменено"
    [ "$answer" = "YES" ] || die "отменено"
    for p in "${found[@]}"; do
      case "$p" in "$mem"/*) ;; *) die "путь вне memory: $p" ;; esac
      case "/$p/" in */../*|*/./*) die "подозрительный путь: $p" ;; esac
      runuser -u brain -- rm -rf --one-file-system -- "$p" || warn "не удалилось: $p"
    done
    ok "удалено: ${#found[@]}"
    ;;

  ""|-h|--help|help) usage ;;
  *) usage; die "неизвестная команда: $cmd" ;;
esac
