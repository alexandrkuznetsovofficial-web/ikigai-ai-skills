# brain-link kit 2.1 — сторож раз в час; сообщение владельцу не чаще раза в сутки на тип проблемы.
# Самопроверка безопасности — изнутри watch раз в неделю (лимит 1/сутки, ≤ 8 вызовов claude).
[Unit]
Description=brain-watch: ежечасная проверка сервера

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=120
Unit=brain-watch.service

[Install]
WantedBy=timers.target
