# brain-link kit 2.1 — утренний брифинг владельцу. Запускает brain-brief.timer.
[Unit]
Description=brain-brief: утренний брифинг в Telegram (brain-link)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# kit 2.1 (RT-11): отдельный системный пользователь бота. LoadCredential отдаёт /run/credentials/<юнит>/
# во владение пользователю юнита — под brain их читал бы любой процесс brain (ssh-вход). brainbot — без
# входа (nologin), в группе brain (читает память 0640/0750), пишет только inbox/dialogues (2770) и своё
# состояние /var/lib/brain-bot (0700 brainbot: конфиг claude, безопасный режим, итоги самопроверки).
User=brainbot
Group=brain
StateDirectory=brain-bot
StateDirectoryMode=0700
WorkingDirectory=/home/brain
ExecStart=/usr/bin/python3 /usr/local/lib/brain-bot/brain_bot.py brief
Environment=OWNER_ID=__OWNER_ID__
Environment=BOT_TZ=Europe/Moscow
Environment=DIALOGUES=0
Environment=LANG=C.UTF-8
Environment=BRAIN_STATE_DIR=/var/lib/brain-bot
Environment=XDG_CACHE_HOME=/var/lib/brain-bot/cache
Environment=PATH=/home/brain/.local/bin:/usr/local/bin:/usr/bin:/bin
LoadCredential=bot_token:/etc/brain-bot/credentials/bot_token
LoadCredential=claude_token:/etc/brain-bot/credentials/claude_token
UMask=0007
TimeoutStartSec=600

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# CLAUDE_CONFIG_DIR бота — /var/lib/brain-bot/claude-config (StateDirectory); /home/brain — только чтение
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# kit 2.1: ядро, /proc, IPC, capabilities. ProcSubset=pid прячет /proc/uptime и т.п. — бот берёт CLOCK_BOOTTIME.
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
SystemCallArchitectures=native
RestrictNamespaces=yes
# SSRF: ни облачных метаданных (link-local 169.254/16), ни сервисов на localhost.
# Исключение — 127.0.0.53 (stub systemd-resolved, через него резолвятся имена на Ubuntu 24.04);
# Allow сильнее Deny, остальной интернет (Telegram, Anthropic) не затронут.
IPAddressDeny=link-local localhost multicast
IPAddressAllow=127.0.0.53/32
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1500M
CPUQuota=150%
TasksMax=256
