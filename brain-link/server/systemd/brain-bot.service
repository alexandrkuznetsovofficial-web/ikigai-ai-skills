# brain-link kit 2.1 — Telegram-бот второго мозга («как Тим»).
# Ставит harden.sh / brain-link bot. OWNER_ID подставляет установщик вместо __OWNER_ID__;
# пока стоит плейсхолдер, бот не стартует (fail-closed). Секреты — только LoadCredential.
[Unit]
Description=brain-bot: Telegram-бот второго мозга (brain-link)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
# kit 2.1 (RT-11): отдельный системный пользователь бота. LoadCredential отдаёт /run/credentials/<юнит>/
# во владение пользователю юнита — под brain их читал бы любой процесс brain (ssh-вход). brainbot — без
# входа (nologin), в группе brain (читает память 0640/0750), пишет только inbox/dialogues (2770) и своё
# состояние /var/lib/brain-bot (0700 brainbot: конфиг claude, безопасный режим, итоги самопроверки).
User=brainbot
Group=brain
StateDirectory=brain-bot
StateDirectoryMode=0700
WorkingDirectory=/home/brain
# VOICE=1: ExecStart меняется на /usr/local/lib/brain-bot/voice-venv/bin/python3 (venv root-владения, не в /home/brain)
# и MemoryMax=2500M (делает brain-link bot --voice)
ExecStart=/usr/bin/python3 /usr/local/lib/brain-bot/brain_bot.py run
Environment=OWNER_ID=__OWNER_ID__
Environment=VOICE=0
Environment=DIALOGUES=1
Environment=BOT_TZ=Europe/Moscow
Environment=LANG=C.UTF-8
Environment=BRAIN_STATE_DIR=/var/lib/brain-bot
Environment=XDG_CACHE_HOME=/var/lib/brain-bot/cache
Environment=PYTHONUNBUFFERED=1
# RT-11b: claude бота — root-копия (sudo brain-admin update-claude), sha256 сверяется при старте; в PATH нет
# ни одной папки brain (~/.local/bin владельца бот не использует)
Environment=PATH=/usr/local/lib/brain-bot/claude/bin:/usr/local/bin:/usr/bin:/bin
Environment=CLAUDE_BIN=/usr/local/lib/brain-bot/claude/bin/claude
LoadCredential=bot_token:/etc/brain-bot/credentials/bot_token
LoadCredential=claude_token:/etc/brain-bot/credentials/claude_token
# приманки самопроверки (фальшивые CANARY-значения, кладёт harden / brain-admin canary-init): бот прячет
# ответ, если модель их вывела; brain-admin selfcheck-security берёт отсюда же все свойства песочницы
LoadCredential=canary_list:/etc/brain-bot/canary.list
UMask=0007
Restart=always
RestartSec=10

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# CLAUDE_CONFIG_DIR бота — /var/lib/brain-bot/claude-config (StateDirectory); /home/brain — только чтение
ReadWritePaths=/home/brain/memory/inbox /home/brain/memory/dialogues
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# kit 2.1: ядро, /proc, IPC, capabilities. ProcSubset=pid прячет /proc/uptime и т.п. — бот берёт CLOCK_BOOTTIME.
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
SystemCallArchitectures=native
RestrictNamespaces=yes
# SSRF: ни облачных метаданных (link-local 169.254/16), ни сервисов на localhost.
# Исключение — 127.0.0.53 (stub systemd-resolved, через него резолвятся имена на Ubuntu 24.04);
# Allow сильнее Deny, остальной интернет (Telegram, Anthropic) не затронут.
IPAddressDeny=link-local localhost multicast
IPAddressAllow=127.0.0.53/32
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1500M
CPUQuota=150%
TasksMax=256

[Install]
WantedBy=multi-user.target
