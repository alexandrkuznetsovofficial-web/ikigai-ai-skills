# brain-link kit 2.1 — Telegram-бот второго мозга («как Тим»).
# Ставит harden.sh / brain-link bot. OWNER_ID подставляет установщик вместо __OWNER_ID__;
# пока стоит плейсхолдер, бот не стартует (fail-closed). Секреты — только LoadCredential.
[Unit]
Description=brain-bot: Telegram-бот второго мозга (brain-link)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=brain
Group=brain
WorkingDirectory=/home/brain
# VOICE=1: ExecStart меняется на /home/brain/.venv-voice/bin/python3 и MemoryMax=2500M (делает brain-link bot --voice)
ExecStart=/usr/bin/python3 /usr/local/lib/brain-bot/brain_bot.py run
Environment=OWNER_ID=__OWNER_ID__
Environment=VOICE=0
Environment=DIALOGUES=1
Environment=BOT_TZ=Europe/Moscow
Environment=LANG=C.UTF-8
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/brain/.local/bin:/usr/local/bin:/usr/bin:/bin
LoadCredential=bot_token:/etc/brain-bot/credentials/bot_token
LoadCredential=claude_token:/etc/brain-bot/credentials/claude_token
# приманки самопроверки (фальшивые CANARY-значения, кладёт harden / brain-admin canary-init): бот прячет
# ответ, если модель их вывела; brain-admin selfcheck-security берёт отсюда же все свойства песочницы
LoadCredential=canary_list:/etc/brain-bot/canary.list
UMask=0027
Restart=always
RestartSec=10

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# CLAUDE_CONFIG_DIR бота — внутри .local/state/brain-bot; ~/.claude (скиллы) и ~/.brain-sync — только чтение
ReadWritePaths=/home/brain/memory/inbox /home/brain/memory/dialogues /home/brain/.cache /home/brain/.local/state/brain-bot
ReadWritePaths=-/home/brain/.local/state/claude -/home/brain/.local/share/claude
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# kit 2.1: ядро, /proc, IPC, capabilities. ProcSubset=pid прячет /proc/uptime и т.п. — бот берёт CLOCK_BOOTTIME.
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
SystemCallArchitectures=native
RestrictNamespaces=yes
# SSRF: ни облачных метаданных (link-local 169.254/16), ни сервисов на localhost.
# Исключение — 127.0.0.53 (stub systemd-resolved, через него резолвятся имена на Ubuntu 24.04);
# Allow сильнее Deny, остальной интернет (Telegram, Anthropic) не затронут.
IPAddressDeny=link-local localhost multicast
IPAddressAllow=127.0.0.53/32
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1500M
CPUQuota=150%
TasksMax=256

[Install]
WantedBy=multi-user.target
