{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash",
      "Edit",
      "Write",
      "NotebookEdit",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(//etc/**)",
      "Read(//run/**)",
      "Read(//root/**)",
      "Read(//var/log/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/projects/**)",
      "Read(~/.claude/todos/**)",
      "Read(~/.claude/shell-snapshots/**)",
      "Read(~/.claude/statsig/**)",
      "Read(~/.claude.json)",
      "Read(~/.ssh/**)",
      "Read(~/.config/**)",
      "Read(~/.cache/**)",
      "Read(~/.local/**)",
      "Read(~/.brain-sync/**)",
      "Read(~/.bash_history)",
      "Read(//home/brain/.claude/.credentials.json)",
      "Read(//home/brain/.claude/projects/**)",
      "Read(//home/brain/.claude/todos/**)",
      "Read(//home/brain/.claude/shell-snapshots/**)",
      "Read(//home/brain/.claude/statsig/**)",
      "Read(//home/brain/.claude.json)",
      "Read(//home/brain/.ssh/**)",
      "Read(//home/brain/.config/**)",
      "Read(//home/brain/.cache/**)",
      "Read(//home/brain/.local/**)",
      "Read(//home/brain/.brain-sync/**)",
      "Read(//home/brain/.brain-trash/**)",
      "Read(**/.env)",
      "Read(**/*.env)",
      "Read(**/*.session)",
      "Read(**/.secrets/**)"
    ]
  },
  "enableAllProjectMcpServers": false
}
