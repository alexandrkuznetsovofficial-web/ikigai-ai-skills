# ФАЙЛ ДОСТУПА — шаблон
#
# Скопируй этот файл сюда:
#   mkdir -p ~/.config/brain
#   cp server_access.example ~/.config/brain/server_access
#   chmod 600 ~/.config/brain/server_access
#
# Потом открой его и впиши свои значения вместо <...>.
#
# ЭТОТ ФАЙЛ НИКОМУ НЕ ПЕРЕСЫЛАЙ. Ни в чат Потока, ни Александру,
# ни «самому себе» в Telegram. Он живёт только на твоём компьютере.

# --- Сервер (получишь от FoxCloud после оплаты) ---
SERVER_IP=<IP-адрес сервера>
SERVER_USER=root
SERVER_PORT=22

# --- Telegram-бот (получишь у @BotFather) ---
BOT_TOKEN=<строка вида 7123456789:AAF...>

# --- Твой user_id (получишь у @userinfobot) ---
USER_ID=<только цифры>

# --- Токен подписки для сервера ---
# Получаешь САМА командой в своём терминале:  claude setup-token
# Она откроет браузер, ты войдёшь под своей подпиской.
# На выходе строка sk-ant-oat... — впиши её сюда.
CLAUDE_TOKEN=<строка вида sk-ant-oat...>
