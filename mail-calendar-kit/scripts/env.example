# Файл доступов пака «Второй мозг ↔ почта и календарь».
# Копия этого файла живёт в ~/.config/mail-calendar-kit/.env (права 600).
# Пустое значение у IMAP_*/SMTP_* = взять пресет провайдера из MAIL_PROVIDER.
# Пароли здесь — ТОЛЬКО пароли приложений, никогда не основной пароль от аккаунта.

# ---------- ПОЧТА ----------
# yandex | gmail | mailru | icloud | custom
MAIL_PROVIDER=yandex
# Полный адрес ящика (для iCloud IMAP-логин без домена вычисляется сам)
MAIL_USER=
# Пароль приложения для почты (Яндекс: тип «Почта»; Gmail: App password; Mail.ru: «пароль для внешнего приложения»; iCloud: app-specific password)
MAIL_PASSWORD=
# Как подписывать исходящие письма (необязательно)
MAIL_FROM_NAME=
# Переопределение хостов только для MAIL_PROVIDER=custom (иначе оставить пустым)
IMAP_HOST=
IMAP_PORT=
SMTP_HOST=
SMTP_PORT=
# ssl | starttls (только для custom)
SMTP_MODE=

# ---------- КАЛЕНДАРЬ ----------
# yandex | mailru | icloud | google | ics_link | none
#   icloud   — календарь айфона, если встречи лежат в iCloud: полный доступ, Google не нужен
#   google   — полный доступ к Google Calendar (нужен вход через браузер, см. gcal_auth.py)
#   ics_link — любой календарь по ссылке .ics: только чтение, зато настройка за минуту
CAL_PROVIDER=yandex
# Для CalDAV-провайдеров (yandex / mailru / icloud). Пустой URL = пресет провайдера.
CALDAV_URL=
CALDAV_USER=
# У Яндекса это ОТДЕЛЬНЫЙ пароль приложения типа «Календарь» (не почтовый). Начинает действовать через 2–3 часа.
CALDAV_PASSWORD=
# Имя календаря, если их несколько (пусто = первый/основной)
CALDAV_CALENDAR=
# Для CAL_PROVIDER=ics_link — ссылка на календарь в формате iCal.
#   Google: Настройки календаря → нужный календарь → «Секретный адрес в формате iCal»
#   Apple:  Календарь на телефоне → «Общий доступ» → «Открытый календарь» → скопировать ссылку
#   Яндекс: Настройки календаря → «Экспортировать» → ссылка iCal
# Ссылка webcal:// тоже подойдёт, её переведём сами. Это чтение; ставить встречи — письмом-приглашением.
CALENDAR_ICS_URL=

# Для CAL_PROVIDER=google
GCAL_CREDENTIALS_PATH=~/.config/mail-calendar-kit/gcal_credentials.json
GCAL_TOKEN_PATH=~/.config/mail-calendar-kit/gcal_token.json
GCAL_CALENDAR_ID=primary

# ---------- ОБЩЕЕ ----------
TZ=Europe/Moscow
# Рабочие часы для поиска свободных окон (freeslots)
WORK_HOUR_FROM=10
WORK_HOUR_TO=19
# Предохранитель: 0 = отправка писем и рассылка приглашений запрещены (только чтение и события в своём календаре).
# Ставится в 1 на приёмке, если ты выбрал задачи с отправкой.
MCK_SEND_ALLOWED=0

# ---------- NOTION (необязательно) ----------
NOTION_TOKEN=

# ---------- ДЛЯ БОТА (заполняет скилл при подключении бота) ----------
# Python из venv пака и папка скилла — чтобы бот знал, что запускать.
# Имена свои у каждого пака: у Telegram-пака свои TPK_*, общие имена конфликтовали бы.
MCK_PYTHON=
MCK_DIR=
# Путь к этому файлу для бота (если отличается от ~/.config/mail-calendar-kit/.env)
MCK_ENV=
