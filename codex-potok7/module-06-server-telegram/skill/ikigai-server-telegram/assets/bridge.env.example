# Nonsecret settings only. Real bot token is entered privately in bot.token, not here.
BRAIN_OWNER_ID=REPLACE_WITH_CONFIRMED_NUMERIC_TELEGRAM_USER_ID
BRAIN_TOKEN_FILE=/etc/ikigai/bot.token
BRAIN_STATE=/srv/ikigai/state
BRAIN_SNAPSHOT=/srv/ikigai/approved
BRAIN_CODEX_HOME=/srv/ikigai/codex-home
BRAIN_CODEX_BIN=/usr/local/bin/codex
PATH=/usr/local/bin:/usr/bin:/bin
